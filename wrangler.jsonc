{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ygo-platform",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // API, image proxy and websocket paths go to the Worker first
    "run_worker_first": ["/api/*", "/img/*", "/ws/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ygo-platform",
      // production database (wrangler d1 create ygo-platform)
      "database_id": "f821269b-c0ef-4ab0-b292-a25b87568a6e",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      // one instance per duel room (manual sim + rules engine)
      { "name": "DUEL_ROOM", "class_name": "DuelRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DuelRoom"] }],
  "vars": {
    // where rules-enforced duels run: "host" = the room host's browser (free plan),
    // "server" = the DuelRoom Durable Object (needs Workers Paid for CPU)
    "ENGINE_RUNNER": "host"
  },
  "observability": { "enabled": true }
}
